Replace PCRE-backed nre with Nim's standard PEG matcher.

diff --git a/src/common/colors.nim b/src/common/colors.nim
--- a/src/common/colors.nim
+++ b/src/common/colors.nim
@@ -1,5 +1,5 @@
 from "types" import Color, ColorSet
-import nre
+import std/pegs
 
 proc initForeground(): ColorSet =
     result.Black   = "\e[30m"
@@ -50,7 +50,7 @@
 const Default*: Color = static: "\e[0m"
 
 proc Uncolorize*(s: string): string =
-    result = s.replace(nre.re"\e(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])", "")
+    result = s.replace(peg"\27 ([@-Z\\-_] / '[' [0-?]* [ -/]* [@-~])", "")
 
 proc Reset*() =
     stdout.write(Default)
